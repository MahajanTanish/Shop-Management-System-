# BikeParts Smart AI — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file with real secrets to source control.

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API

# Your project's public URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# The anon/public key — safe to use in browser code
# This key is subject to Row-Level Security (RLS) policies
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Application ──────────────────────────────────────────────────────────────
VITE_APP_NAME=BikeParts Smart AI
VITE_APP_VERSION=0.1.0

# ─── Security notes ───────────────────────────────────────────────────────────
# The SERVICE_ROLE key grants bypasses all RLS — NEVER put it here.
# The SERVICE_ROLE key must only be used in trusted server environments
# (Supabase Edge Functions, secure backend APIs) and never in browser code.
#
# Verify before production:
# - SUPABASE_URL points to your dedicated production project (not shared/demo)
# - RLS policies are enabled and tested on all tables
# - Supabase Auth email confirmation is configured appropriately
# - Supabase project has no public API access beyond anon key + RLS
